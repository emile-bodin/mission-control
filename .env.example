# Public HTTPS endpoint, terminated by an existing reverse proxy.
PUBLIC_BASE_URL=https://hera.connect2home.nl
# Comma-separated IP addresses/CIDRs of reverse-proxy peers as seen by frontend.
# Set this to the proxy's real Docker/LAN source address; do not use 0.0.0.0/0.
TRUSTED_PROXY_CIDRS=CHANGE_ME

# Internal HTTP upstream for the existing reverse proxy. Restrict this port by firewall.
FRONTEND_PORT=3100

# PostgreSQL
POSTGRES_DB=bodin
POSTGRES_USER=bodin
# Placeholder only. Replace in local .env before exposing PostgreSQL.
POSTGRES_PASSWORD=replace-with-local-password
GOOGLE_CALENDAR_ICS_URL=

# Pulse (read-only homelab inventory/status source)
PULSE_BASE_URL=
PULSE_API_TOKEN=

# Generate distinct high-entropy values; never commit real secrets.
DEVICE_TOKEN_PEPPER=CHANGE_ME
DEVICE_ADMIN_TOKEN=CHANGE_ME
